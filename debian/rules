#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release

override_dh_auto_install:
	dh_auto_install
	# Install desktop file and icon
	install -D -m 0644 debian/tmp/usr/share/applications/uScope.desktop \
		$(CURDIR)/debian/uscope/usr/share/applications/uscope.desktop
	install -D -m 0644 images/uScope.svg \
		$(CURDIR)/debian/uscope/usr/share/icons/hicolor/scalable/apps/uscope.svg
